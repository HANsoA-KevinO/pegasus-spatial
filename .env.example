# Pegasus Spatial local defaults. Copy to .env.local and replace every secret.
PORT=3200
APP_PUBLIC_URL=http://localhost:3200
MONGODB_URI=mongodb://127.0.0.1:27019/pegasus_spatial

CRON_SECRET=replace-with-a-second-random-secret-at-least-32-characters

# Shared NewAPI gateway. Root/Tool model calls and GenerateImage use the same
# base URL; GenerateImage authenticates with LLM_API_KEY_TOOLS.
LLM_BASE_URL=
LLM_API_KEY_ORCHESTRATOR=
LLM_API_KEY_TOOLS=
# Emergency local-development escape hatch for a legacy public HTTP NewAPI.
# Never enable in production; readiness will still report such a URL as unsafe.
PEGASUS_SPATIAL_ALLOW_INSECURE_NEWAPI_HTTP=0

# Durable Agent runtime. Use a distinct random internal secret.
AGENT_RUNTIME_BACKGROUND_RUNNER=1
AGENT_RUNTIME_INTERNAL_BASE_URL=http://127.0.0.1:3200
AGENT_RUNTIME_INTERNAL_SECRET=replace-with-a-third-random-secret-at-least-32-characters
AGENT_RUNTIME_WORKERS=50

# Raster/media isolation. GridFS is the local default.
MEDIA_STORAGE_DRIVER=gridfs
MEDIA_PUBLIC_BASE_URL=http://localhost:3200
LLM_IMAGE_TRANSPORT=inline

# Dedicated credential for the bundled, isolated Chromium renderer (24+ chars).
# Run compose with --env-file .env.production so both services share this token.
SCENE_CODE_RENDERER_TOKEN=
SCENE_CODE_RENDERER_URL=http://127.0.0.1:3201
# Optional for local dev: absolute path to an installed Chromium executable.
# With a path set, predev/local:up starts a native sandboxed renderer instead of Docker.
SCENE_CODE_CHROMIUM_EXECUTABLE_PATH=
SCENE_CODE_WORKER_ENABLED=1
# Development only: installed Chromium executable; bundled image supplies it.
# SCENE_CODE_CHROMIUM_EXECUTABLE_PATH=
# Non-sensitive and intentionally public: server writers and browser CDN URLs
# must use this exact same slash-free prefix.
NEXT_PUBLIC_PEGASUS_SPATIAL_MEDIA_PREFIX=raster-assets/pegasus-spatial

# Primary New API Images alias (case-sensitive). Edits use it unless overridden.
PEGASUS_SPATIAL_IMAGE_MODEL=gpt-image-2
PEGASUS_SPATIAL_IMAGE_EDIT_MODEL=
# Optional Chat Completions image alias for explicit pre-dispatch failures.
PEGASUS_SPATIAL_IMAGE_FALLBACK_MODEL=

# Paid spatial providers. *_API_KEY is canonical; *_API_TOKEN is a legacy alias.
AHOLO_API_BASE_URL=https://api.aholo3d.cn
AHOLO_API_KEY=
AHOLO_ASSET_HOST_ALLOWLIST=
# AHOLO_API_TOKEN=
LUX3D_API_BASE_URL=https://api.aholo3d.cn
LUX3D_API_KEY=
LUX3D_ASSET_HOST_ALLOWLIST=
# LUX3D_API_TOKEN=

# Fail closed until live smoke tests succeed.
SPATIAL_WORKER_ENABLED=1
SPATIAL_WORKER_CONCURRENCY=8
SPATIAL_WORKER_POLL_MS=2000
SPATIAL_WORKER_LEASE_MS=90000
SPATIAL_MAX_ASSET_BYTES=209715200
SPATIAL_MAX_BATCH_BYTES=402653184
# Runtime further narrows this to 8 Aholo artifacts or 4 Lux3D artifacts.
SPATIAL_MAX_ARTIFACT_COUNT=16

# Optional OSS media storage (required together when MEDIA_STORAGE_DRIVER=oss).
# OSS_REGION=
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_STS_TOKEN=
# OSS_ENDPOINT=
# Per-request timeout and safe immutable-object retry policy. These retries only
# repeat OSS persistence; they never resubmit a paid image generation request.
# OSS_REQUEST_TIMEOUT_MS=120000
# OSS_UPLOAD_ATTEMPTS=3
# OSS_CDN_BASE_URL=https://media.example.com
# NEXT_PUBLIC_MEDIA_CDN_BASE_URL=https://media.example.com

# Main model responses per Agent execution; one response may call many tools.
# 0 explicitly disables the turn cap. Cancellation and other budgets still apply.
AGENT_MAX_TURNS=200
# AGENT_ROOT_MAX_TURNS=200
# AGENT_MEMBER_MAX_TURNS=200
# SCENE_CODE_ACCEPTANCE_MAX_TURNS=200
